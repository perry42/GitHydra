{
  "name": "githydra-demo-kit",
  "private": true,
  "description": "Dev-only play buttons: VS Code Explorer > NPM Scripts shows a play button next to each scenario; pressing it rebuilds the app only if the build is missing or older than the code, then launches the scenario. Keep in sync with scenarios/ (a test checks it). Not part of the workspaces or the packaged app.",
  "scripts": {
    "00-build-app": "npm run build --prefix ../..",
    "00-list": "node run.mjs --list",
    "merge-conflict-multi": "node run.mjs merge-conflict-multi --auto-build",
    "rebase-conflict": "node run.mjs rebase-conflict --auto-build",
    "cherry-pick-conflict": "node run.mjs cherry-pick-conflict --auto-build",
    "delete-modify-conflict": "node run.mjs delete-modify-conflict --auto-build",
    "rename-add-conflict": "node run.mjs rename-add-conflict --auto-build",
    "binary-only-conflict": "node run.mjs binary-only-conflict --auto-build",
    "crlf-conflict": "node run.mjs crlf-conflict --auto-build",
    "long-file-conflict": "node run.mjs long-file-conflict --auto-build",
    "many-conflicts": "node run.mjs many-conflicts --auto-build",
    "diff3-conflict": "node run.mjs diff3-conflict --auto-build",
    "conflict-with-big-line": "node run.mjs conflict-with-big-line --auto-build",
    "partly-staged-edits": "node run.mjs partly-staged-edits --auto-build",
    "edit-misc": "node run.mjs edit-misc --auto-build",
    "many-files": "node run.mjs many-files --auto-build",
    "stash-heavy": "node run.mjs stash-heavy --auto-build",
    "big-history": "node run.mjs big-history --auto-build",
    "detached-head": "node run.mjs detached-head --auto-build",
    "submodule-present": "node run.mjs submodule-present --auto-build",
    "empty-repo": "node run.mjs empty-repo --auto-build",
    "worktree": "node run.mjs worktree --auto-build",
    "worktrees-tour": "node run.mjs worktrees-tour --auto-build",
    "recovery-draft": "node run.mjs recovery-draft --auto-build",
    "clean-repo": "node run.mjs clean-repo --auto-build",
    "multi-tab": "node run.mjs multi-tab --auto-build",
    "live-refresh": "node run.mjs live-refresh --auto-build"
  }
}
