    "merge-conflict-multi": "node run.mjs merge-conflict-multi",
    "rebase-conflict": "node run.mjs rebase-conflict",
    "cherry-pick-conflict": "node run.mjs cherry-pick-conflict",
    "delete-modify-conflict": "node run.mjs delete-modify-conflict",
    "rename-add-conflict": "node run.mjs rename-add-conflict",
    "binary-only-conflict": "node run.mjs binary-only-conflict",
    "crlf-conflict": "node run.mjs crlf-conflict",
    "long-file-conflict": "node run.mjs long-file-conflict",
    "many-conflicts": "node run.mjs many-conflicts",
    "diff3-conflict": "node run.mjs diff3-conflict",
    "conflict-with-big-line": "node run.mjs conflict-with-big-line",
    "partly-staged-edits": "node run.mjs partly-staged-edits",
    "edit-misc": "node run.mjs edit-misc",
    "many-files": "node run.mjs many-files",
    "stash-heavy": "node run.mjs stash-heavy",
    "big-history": "node run.mjs big-history",
    "detached-head": "node run.mjs detached-head",
    "submodule-present": "node run.mjs submodule-present",
    "empty-repo": "node run.mjs empty-repo",
    "worktree": "node run.mjs worktree",
    "recovery-draft": "node run.mjs recovery-draft",
    "clean-repo": "node run.mjs clean-repo",
    "multi-tab": "node run.mjs multi-tab",
    "live-refresh": "node run.mjs live-refresh"
  }
}
