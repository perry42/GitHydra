{
  "name": "githydra-demo-kit",
  "private": true,
  "description": "Dev-only play buttons: VS Code Explorer > NPM Scripts shows a play button next to each scenario. Keep in sync with scenarios/ (a test checks it). Not part of the workspaces or the packaged app.",
  "scripts": {
    "00-build-app": "npm run build --prefix ../..",
